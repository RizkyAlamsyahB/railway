Project "haji_umroh_store_mvp" {
  database_type: "PostgreSQL"
  Note: '''
  ERD MVP marketplace oleh-oleh haji/umroh.
  Fokus: onboarding user/UMKM, katalog, cart, order, payment, refund, payout, dan ledger.
  '''
}

Table "users" {
  "id" UUID [pk, not null]
  "email" VARCHAR(255) [not null]
  "full_name" VARCHAR(120) [not null]
  "birth_date" DATE
  "phone" VARCHAR(20) [unique]
  "password_hash" TEXT [not null]
  "status" VARCHAR(16) [not null, default: 'pending']
  "role_id" SMALLINT [not null]
  "email_verified_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `status IN ('pending', 'active', 'blocked')` [name: 'ck_users_status']
  }

  Indexes {
    `lower(email)` [unique, name: "uq_users_email_lower"]
  }
}

Table "email_verification_tokens" {
  "id" UUID [pk, not null]
  "user_id" UUID [not null]
  "email" VARCHAR(255) [not null]
  "token_hash" TEXT [not null]
  "expires_at" TIMESTAMPTZ [not null]
  "consumed_at" TIMESTAMPTZ
  "invalidated_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    (token_hash) [unique, name: "uq_email_verification_tokens_token_hash"]
    (user_id) [unique, name: "uq_email_verification_tokens_user_active", note: 'partial index: consumed_at IS NULL AND invalidated_at IS NULL']
    (expires_at) [name: "idx_email_verification_tokens_expires_at"]
    (user_id, created_at) [name: "idx_email_verification_tokens_user_created_at"]
  }
}

Table "roles" {
  "id" SMALLINT [pk, increment]
  "code" VARCHAR(30) [unique, not null, note: 'admin, umkm, customer, cs, finance']
  "name" VARCHAR(60) [not null]
}


Table "addresses" {
  "id" UUID [pk, not null]
  "user_id" UUID [not null]
  "label" VARCHAR(40)
  "recipient_name" VARCHAR(120)
  "phone" VARCHAR(20)
  "province_id" VARCHAR(20)
  "city_id" VARCHAR(20)
  "district_id" VARCHAR(20)
  "postal_code" VARCHAR(10)
  "address_line" TEXT [not null]
  "is_default" BOOLEAN [not null, default: false]
}

Table "vendors" {
  "id" UUID [pk, not null]
  "owner_user_id" UUID [not null]
  "vendor_type" VARCHAR(32) [not null, default: 'general_souvenir_store']
  "legal_name" VARCHAR(160)
  "display_name" VARCHAR(120) [not null]
  "responsible_person_name" VARCHAR(120) [not null]
  "description" TEXT
  "status" VARCHAR(16) [not null, default: 'draft']
  "approved_by" UUID
  "approved_at" TIMESTAMPTZ
  "status_reason" TEXT
  "xendit_account_id" VARCHAR(255)
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `vendor_type IN ('umrah_souvenir_store', 'hajj_souvenir_store', 'general_souvenir_store')` [name: 'ck_vendors_vendor_type']
    `status IN ('draft', 'submitted', 'active', 'rejected', 'blocked')` [name: 'ck_vendors_status']
  }

  Indexes {
    (owner_user_id) [unique, name: "uq_vendors_owner_user"]
  }
}

Table "vendor_documents" {
  "id" UUID [pk, not null]
  "vendor_id" UUID [not null]
  "doc_type" VARCHAR(40) [not null, note: 'owner_document_id, business_npwp, store_photo, bank_account_proof, business_logo, business_banner']
  "file_url" TEXT [not null]
  "mime_type" VARCHAR(100)
  "file_size_bytes" INT
  "file_checksum" VARCHAR(128)
  "uploaded_by" UUID
  "verification_status" VARCHAR(16) [not null, default: 'pending']
  "rejection_reason" TEXT
  "verified_by" UUID
  "verified_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `doc_type IN ('owner_document_id', 'business_npwp', 'store_photo', 'bank_account_proof', 'business_logo', 'business_banner')` [name: 'ck_vendor_documents_doc_type']
    `verification_status IN ('pending', 'verified', 'rejected')` [name: 'ck_vendor_documents_verification_status']
    `(verification_status = 'verified' AND verified_by IS NOT NULL AND verified_at IS NOT NULL) OR (verification_status IN ('pending', 'rejected') AND verified_by IS NULL AND verified_at IS NULL)` [name: 'ck_vendor_documents_verified_consistency']
  }

  Indexes {
    (vendor_id, doc_type) [unique, name: "uq_vendor_documents_vendor_doc_type"]
    (vendor_id, verification_status) [name: "idx_vendor_documents_vendor_status"]
  }
}

Table "vendor_bank_accounts" {
  "id" UUID [pk, not null]
  "vendor_id" UUID [unique, not null]
  "bank_name" VARCHAR(120) [not null]
  "account_number" VARCHAR(60) [not null]
  "account_holder_name" VARCHAR(160) [not null]
  "verification_status" VARCHAR(16) [not null, default: 'pending']
  "rejection_reason" TEXT
  "verified_by" UUID
  "verified_at" TIMESTAMPTZ
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `verification_status IN ('pending', 'verified', 'rejected')` [name: 'ck_vendor_bank_accounts_verification_status']
    `(verification_status = 'verified' AND verified_by IS NOT NULL AND verified_at IS NOT NULL) OR (verification_status IN ('pending', 'rejected') AND verified_by IS NULL AND verified_at IS NULL)` [name: 'ck_vendor_bank_accounts_verified_consistency']
  }

  Indexes {
    (verification_status) [name: "idx_vendor_bank_accounts_status"]
  }
}

Table "categories" {
  "id" UUID [pk, not null]
  "parent_id" UUID
  "name" VARCHAR(80) [not null]
  "slug" VARCHAR(100) [unique, not null]
  "is_active" BOOLEAN [not null, default: true]
}

Table "products" {
  "id" UUID [pk, not null]
  "vendor_id" UUID [not null]
  "category_id" UUID [not null]
  "name" VARCHAR(180) [not null]
  "slug" VARCHAR(220) [unique, not null]
  "description" TEXT [not null]
  "status" VARCHAR(16) [not null, default: 'draft']
  "halal_ai_status" VARCHAR(16) [not null, default: 'pending']
  "halal_ai_notes" TEXT
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `status IN ('draft', 'published', 'blocked', 'archived')` [name: 'ck_products_status']
    `halal_ai_status IN ('pending', 'passed', 'failed')` [name: 'ck_products_halal_ai_status']
  }

  Indexes {
    (vendor_id, status) [name: "idx_products_vendor_status"]
  }
}

Table "shipping_services" {
  "id" UUID [pk, not null]
  "code" VARCHAR(40) [unique, not null]
  "name" VARCHAR(80) [not null]
  "is_active" BOOLEAN [not null, default: true]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
}

Table "product_shipping_services" {
  "product_id" UUID [not null]
  "shipping_service_id" UUID [not null]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    (product_id, shipping_service_id) [pk, name: "pk_product_shipping_services"]
    (product_id) [name: "idx_product_shipping_services_product_id"]
    (shipping_service_id) [name: "idx_product_shipping_services_shipping_service_id"]
  }
}

Table "product_images" {
  "id" UUID [pk, not null]
  "product_id" UUID [not null]
  "image_url" TEXT [not null]
  "mime_type" VARCHAR(100)
  "file_size_bytes" INT
  "is_primary" BOOLEAN [not null, default: false]
  "sort_order" INT [not null, default: 0]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `sort_order >= 0` [name: 'ck_product_images_sort_order_non_negative']
  }

  Indexes {
    (product_id, sort_order) [name: "idx_product_images_product_sort"]
    (product_id) [unique, name: "uq_product_images_primary_per_product", note: 'partial index: is_primary = true']
  }
}

Table "product_variants" {
  "id" UUID [pk, not null]
  "product_id" UUID [not null]
  "sku" VARCHAR(80) [not null]
  "variant_name" VARCHAR(120) [not null]
  "price" NUMERIC(18,2) [not null]
  "currency" CHAR(3) [not null, default: 'IDR']
  "stock_on_hand" INT [not null]
  "weight_gram" INT
  "is_default" BOOLEAN [not null, default: false]
  "is_active" BOOLEAN [not null, default: true]

  Checks {
    `price > 0` [name: 'ck_product_variants_price_positive']
    `stock_on_hand >= 0` [name: 'ck_product_variants_stock_non_negative']
    `weight_gram IS NULL OR weight_gram >= 0` [name: 'ck_product_variants_weight_non_negative']
  }

  Indexes {
    (product_id, sku) [unique, name: "uq_product_variants_product_sku"]
    (product_id) [unique, name: "uq_product_variants_default_per_product", note: 'partial index: is_default = true']
    (product_id, is_active) [name: "idx_product_variants_product_active"]
  }
}

Table "carts" {
  "id" UUID [pk, not null]
  "user_id" UUID [unique, not null]
  "status" VARCHAR(16) [not null, default: 'active']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `status IN ('active', 'converted', 'abandoned')` [name: 'ck_carts_status']
  }
}

Table "cart_items" {
  "id" UUID [pk, not null]
  "cart_id" UUID [not null]
  "product_variant_id" UUID [not null]
  "qty" INT [not null]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `qty > 0` [name: 'ck_cart_items_qty_positive']
  }

  Indexes {
    (cart_id, product_variant_id) [unique, name: "uq_cart_items_cart_variant"]
  }
}

Table "orders" {
  "id" UUID [pk, not null]
  "order_no" VARCHAR(30) [unique, not null]
  "user_id" UUID [not null]
  "vendor_id" UUID [not null]
  "shipping_address_snapshot" JSONB [not null]
  "order_status" VARCHAR(24) [not null, default: 'pending_payment']
  "payment_status" VARCHAR(16) [not null, default: 'unpaid']
  "subtotal" NUMERIC(18,2) [not null]
  "shipping_fee" NUMERIC(18,2) [not null, default: 0]
  "platform_fee" NUMERIC(18,2) [not null, default: 0]
  "grand_total" NUMERIC(18,2) [not null]
  "placed_at" TIMESTAMPTZ [not null, default: `now()`]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]
  "updated_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `order_status IN ('pending_payment', 'paid', 'packed', 'shipped', 'completed', 'canceled', 'refunded')` [name: 'ck_orders_order_status']
    `payment_status IN ('unpaid', 'paid_partial', 'paid', 'refunded')` [name: 'ck_orders_payment_status']
  }

  Indexes {
    (user_id, created_at) [name: "idx_orders_user_created_at"]
    (vendor_id, created_at) [name: "idx_orders_vendor_created_at"]
    (order_status, payment_status) [name: "idx_orders_status_payment_status"]
  }
}

Table "order_items" {
  "id" UUID [pk, not null]
  "order_id" UUID [not null]
  "product_variant_id" UUID [not null]
  "product_name_snapshot" VARCHAR(180) [not null]
  "sku_snapshot" VARCHAR(80) [not null]
  "qty" INT [not null]
  "unit_price" NUMERIC(18,2) [not null]
  "line_total" NUMERIC(18,2) [not null]

  Checks {
    `qty > 0` [name: 'ck_order_items_qty_positive']
  }
}

Table "order_status_history" {
  "id" UUID [pk, not null]
  "order_id" UUID [not null]
  "old_status" VARCHAR(24)
  "new_status" VARCHAR(24) [not null]
  "changed_by" UUID
  "changed_at" TIMESTAMPTZ [not null, default: `now()`]
  "notes" TEXT

  Checks {
    `old_status IS NULL OR old_status IN ('pending_payment', 'paid', 'packed', 'shipped', 'completed', 'canceled', 'refunded')` [name: 'ck_order_status_history_old_status']
    `new_status IN ('pending_payment', 'paid', 'packed', 'shipped', 'completed', 'canceled', 'refunded')` [name: 'ck_order_status_history_new_status']
  }
}

Table "shipments" {
  "id" UUID [pk, not null]
  "order_id" UUID [unique, not null]
  "courier_code" VARCHAR(30)
  "service_type" VARCHAR(30)
  "tracking_no" VARCHAR(80)
  "shipment_status" VARCHAR(24) [not null, default: 'waiting_pickup']
  "shipped_at" TIMESTAMPTZ
  "delivered_at" TIMESTAMPTZ

  Checks {
    `shipment_status IN ('waiting_pickup', 'shipped', 'delivered', 'failed', 'returned')` [name: 'ck_shipments_status']
  }
}

Table "payment_invoices" {
  "id" UUID [pk, not null]
  "order_id" UUID [not null]
  "gateway" VARCHAR(20) [not null, default: 'xendit']
  "external_invoice_id" VARCHAR(100) [unique, not null]
  "payment_method" VARCHAR(30)
  "amount" NUMERIC(18,2) [not null]
  "currency" CHAR(3) [not null, default: 'IDR']
  "status" VARCHAR(16) [not null, default: 'pending']
  "expires_at" TIMESTAMPTZ
  "paid_at" TIMESTAMPTZ
  "raw_payload" JSONB

  Checks {
    `status IN ('pending', 'paid', 'expired', 'failed')` [name: 'ck_payment_invoices_status']
  }

  Indexes {
    (order_id, status) [name: "idx_payment_invoices_order_status"]
  }
}

Table "payment_events" {
  "id" UUID [pk, not null]
  "payment_invoice_id" UUID [not null]
  "event_type" VARCHAR(50) [not null]
  "external_event_id" VARCHAR(120) [unique, not null, note: 'idempotency key']
  "payload" JSONB [not null]
  "received_at" TIMESTAMPTZ [not null, default: `now()`]
}

Table "refunds" {
  "id" UUID [pk, not null]
  "order_id" UUID [not null]
  "payment_invoice_id" UUID [not null]
  "amount" NUMERIC(18,2) [not null]
  "reason" TEXT
  "status" VARCHAR(16) [not null, default: 'requested']
  "requested_by" UUID [not null]
  "processed_by" UUID
  "processed_at" TIMESTAMPTZ

  Checks {
    `status IN ('requested', 'approved', 'rejected', 'processed')` [name: 'ck_refunds_status']
    `amount > 0` [name: 'ck_refunds_amount_positive']
  }
}

Table "payout_batches" {
  "id" UUID [pk, not null]
  "vendor_id" UUID [not null]
  "period_start" DATE [not null]
  "period_end" DATE [not null]
  "status" VARCHAR(16) [not null, default: 'draft']
  "total_gross" NUMERIC(18,2) [not null]
  "total_fee" NUMERIC(18,2) [not null]
  "total_net" NUMERIC(18,2) [not null]
  "paid_at" TIMESTAMPTZ
  "created_by" UUID [not null]

  Checks {
    `status IN ('draft', 'approved', 'paid', 'failed')` [name: 'ck_payout_batches_status']
  }

  Indexes {
    (vendor_id, status) [name: "idx_payout_batches_vendor_status"]
  }
}

Table "payout_items" {
  "id" UUID [pk, not null]
  "payout_batch_id" UUID [not null]
  "order_id" UUID [not null]
  "gross_amount" NUMERIC(18,2) [not null]
  "platform_fee_amount" NUMERIC(18,2) [not null]
  "net_amount" NUMERIC(18,2) [not null]

  Indexes {
    (payout_batch_id, order_id) [unique, name: "uq_payout_items_batch_order"]
  }
}

Table "ledger_accounts" {
  "id" UUID [pk, not null]
  "code" VARCHAR(20) [unique, not null]
  "name" VARCHAR(120) [not null]
  "account_type" VARCHAR(16) [not null]
  "normal_side" VARCHAR(1) [not null]
  "is_active" BOOLEAN [not null, default: true]

  Checks {
    `account_type IN ('asset', 'liability', 'equity', 'revenue', 'expense')` [name: 'ck_ledger_accounts_account_type']
    `normal_side IN ('D', 'C')` [name: 'ck_ledger_accounts_normal_side']
  }
}

Table "ledger_journals" {
  "id" UUID [pk, not null]
  "journal_no" VARCHAR(40) [unique, not null]
  "source_type" VARCHAR(24) [not null]
  "source_id" UUID [not null, note: 'polymorphic id based on source_type']
  "event_time" TIMESTAMPTZ [not null]
  "description" TEXT
  "status" VARCHAR(16) [not null, default: 'posted']
  "created_by" UUID
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `source_type IN ('order', 'payment_invoice', 'refund', 'payout_batch', 'manual')` [name: 'ck_ledger_journals_source_type']
    `status IN ('posted', 'reversed')` [name: 'ck_ledger_journals_status']
  }

  Indexes {
    (source_type, source_id) [name: "idx_ledger_journals_source"]
  }
}

Table "ledger_lines" {
  "id" UUID [pk, not null]
  "journal_id" UUID [not null]
  "account_id" UUID [not null]
  "debit" NUMERIC(18,2) [not null, default: 0]
  "credit" NUMERIC(18,2) [not null, default: 0]
  "currency" CHAR(3) [not null, default: 'IDR']
  "reference" VARCHAR(80)

  Indexes {
    (account_id) [name: "idx_ledger_lines_account"]
  }
}

Ref "fk_users_role":"roles"."id" < "users"."role_id"
Ref "fk_addresses_user":"users"."id" < "addresses"."user_id"
Ref "fk_email_verification_tokens_user":"users"."id" < "email_verification_tokens"."user_id"

Ref "fk_vendors_owner":"users"."id" < "vendors"."owner_user_id"
Ref "fk_vendors_approved_by":"users"."id" < "vendors"."approved_by"

Ref "fk_vendor_documents_vendor":"vendors"."id" < "vendor_documents"."vendor_id"
Ref "fk_vendor_documents_uploaded_by":"users"."id" < "vendor_documents"."uploaded_by"
Ref "fk_vendor_documents_verified_by":"users"."id" < "vendor_documents"."verified_by"
Ref "fk_vendor_bank_accounts_vendor":"vendors"."id" < "vendor_bank_accounts"."vendor_id"
Ref "fk_vendor_bank_accounts_verified_by":"users"."id" < "vendor_bank_accounts"."verified_by"

Ref "fk_categories_parent":"categories"."id" < "categories"."parent_id"

Ref "fk_products_vendor":"vendors"."id" < "products"."vendor_id"
Ref "fk_products_category":"categories"."id" < "products"."category_id"

Ref "fk_product_shipping_services_product":"products"."id" < "product_shipping_services"."product_id"
Ref "fk_product_shipping_services_shipping_service":"shipping_services"."id" < "product_shipping_services"."shipping_service_id"

Ref "fk_product_images_product":"products"."id" < "product_images"."product_id"
Ref "fk_product_variants_product":"products"."id" < "product_variants"."product_id"

Ref "fk_carts_user":"users"."id" < "carts"."user_id"
Ref "fk_cart_items_cart":"carts"."id" < "cart_items"."cart_id"
Ref "fk_cart_items_product_variant":"product_variants"."id" < "cart_items"."product_variant_id"

Ref "fk_orders_user":"users"."id" < "orders"."user_id"
Ref "fk_orders_vendor":"vendors"."id" < "orders"."vendor_id"

Ref "fk_order_items_order":"orders"."id" < "order_items"."order_id"
Ref "fk_order_items_product_variant":"product_variants"."id" < "order_items"."product_variant_id"

Ref "fk_order_status_history_order":"orders"."id" < "order_status_history"."order_id"
Ref "fk_order_status_history_changed_by":"users"."id" < "order_status_history"."changed_by"

Ref "fk_shipments_order":"orders"."id" < "shipments"."order_id"

Ref "fk_payment_invoices_order":"orders"."id" < "payment_invoices"."order_id"
Ref "fk_payment_events_invoice":"payment_invoices"."id" < "payment_events"."payment_invoice_id"

Ref "fk_refunds_order":"orders"."id" < "refunds"."order_id"
Ref "fk_refunds_invoice":"payment_invoices"."id" < "refunds"."payment_invoice_id"
Ref "fk_refunds_requested_by":"users"."id" < "refunds"."requested_by"
Ref "fk_refunds_processed_by":"users"."id" < "refunds"."processed_by"

Ref "fk_payout_batches_vendor":"vendors"."id" < "payout_batches"."vendor_id"
Ref "fk_payout_batches_created_by":"users"."id" < "payout_batches"."created_by"

Ref "fk_payout_items_batch":"payout_batches"."id" < "payout_items"."payout_batch_id"
Ref "fk_payout_items_order":"orders"."id" < "payout_items"."order_id"

Ref "fk_ledger_journals_created_by":"users"."id" < "ledger_journals"."created_by"

Ref "fk_ledger_lines_journal":"ledger_journals"."id" < "ledger_lines"."journal_id"
Ref "fk_ledger_lines_account":"ledger_accounts"."id" < "ledger_lines"."account_id"

    {
      "id": "0bb6f429-9a2d-4501-be8a-5733db94b381",
      "name": "Chat",
      "item": [
        {
          "name": "Search Chatable Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{finance_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chat/users?q=&roles=&page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chat",
                "users"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "",
                  "description": "Keyword pencarian (nama/email)"
                },
                {
                  "key": "roles",
                  "value": "",
                  "description": "Filter role: umkm, admin, cs, finance. Kosongkan untuk semua yang diizinkan."
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Halaman (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Jumlah per halaman (default: 10)"
                }
              ]
            },
            "description": "Cari user yang dapat diajak chat.\n\nRole yang diizinkan: **UMKM, Admin, CS, Finance**.\n\n**Auth:** Bearer Token"
          },
          "response": [
            {
              "name": "200 - Users Retrieved",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"users retrieved\",\n  \"data\": [\n    {\n      \"id\": \"b2c3d4e5-f6a7-8901-bcde-f12345678901\",\n      \"full_name\": \"Toko Umrah Jaya\",\n      \"email\": \"user@dev.local\",\n      \"role\": \"umkm\"\n    }\n  ],\n  \"errors\": null,\n  \"meta\": {\n    \"page\": 1,\n    \"limit\": 10,\n    \"total_items\": 1,\n    \"total_pages\": 1\n  }\n}"
            },
            {
              "name": "200 - Empty",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"users retrieved\",\n  \"data\": [],\n  \"errors\": null,\n  \"meta\": {\n    \"page\": 1,\n    \"limit\": 10,\n    \"total_items\": 0,\n    \"total_pages\": 1\n  }\n}"
            },
            {
              "name": "401 - Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"missing or invalid token\",\n  \"data\": null,\n  \"errors\": null,\n  \"meta\": null\n}"
            }
          ],
          "id": "e0d68f26-6fe8-494c-b509-d73bd8727bc9"
        },
        {
          "name": "Presign Chat Attachment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data) {",
                  "    pm.collectionVariables.set('chat_attachment_key', json.data.object_key);",
                  "    pm.collectionVariables.set('chat_upload_url', json.data.upload_url);",
                  "    console.log('✅ chat_attachment_key saved: ' + json.data.object_key);",
                  "    console.log('✅ chat_upload_url saved: ' + json.data.upload_url);",
                  "} else {",
                  "    console.log('❌ Presign failed');",
                  "}",
                  "pm.test('presign success', function() {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.upload_url).to.be.a('string');",
                  "    pm.expect(json.data.object_key).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"image/jpeg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/chat/attachment/presign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chat",
                "attachment",
                "presign"
              ]
            },
            "description": "Generate presigned URL untuk upload chat attachment ke S3.\n\n**Content type valid:** `image/jpeg`, `image/png`, `video/mp4`\n**Max file size:** 10 MB\n\n**Flow:**\n1. Panggil endpoint ini → dapat `upload_url` + `object_key`\n2. Upload file ke `upload_url` (PUT request langsung ke S3)\n3. Gunakan `object_key` sebagai `attachment_key` saat Send Message\n\n**Auth:** Bearer Token"
          },
          "response": [
            {
              "name": "200 — Presigned URL Generated",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/chat/attachment/presign"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"presigned upload URL generated\",\n  \"data\": {\n    \"upload_url\": \"https://s3.amazonaws.com/bucket/chat-attachments/2026/03/02/abc123?X-Amz-Signature=...\",\n    \"object_key\": \"chat-attachments/2026/03/02/abc123\",\n    \"content_type\": \"image/jpeg\",\n    \"expires_in\": 1800\n  },\n  \"errors\": null,\n  \"meta\": null\n}"
            },
            {
              "name": "422 — Invalid Content Type",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/chat/attachment/presign"
                }
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"invalid chat attachment content type; allowed: image/png, image/jpeg, video/mp4\",\n  \"data\": null,\n  \"errors\": null,\n  \"meta\": null\n}"
            }
          ],
          "id": "b87f1cd0-d4dc-4346-99b1-7f3af515ac8d"
        },
        {
          "name": "Upload Chat Attachment ke S3",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uploadUrl = pm.collectionVariables.get('chat_upload_url');",
                  "if (!uploadUrl) {",
                  "    console.log('⚠️ chat_upload_url belum ada. Jalankan Presign Chat Attachment dulu!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": {
              "raw": "{{chat_upload_url}}",
              "host": [
                "{{chat_upload_url}}"
              ]
            },
            "description": "Upload file langsung ke S3 menggunakan presigned URL.\n\n**Langkah:**\n1. Pastikan sudah menjalankan **Presign Chat Attachment** → `chat_upload_url` tersimpan otomatis\n2. Di tab **Body** → pilih **binary** → pilih file (JPG/PNG/MP4, maks 10 MB)\n3. Pastikan **Content-Type** di Header sesuai (misal: `image/jpeg`)\n4. Klik **Send** → 200 OK dari S3\n\n**Catatan:** URL ini langsung ke S3, bukan ke API backend. Tidak perlu Authorization header."
          },
          "response": [],
          "id": "737a025e-be7e-4ca8-8c84-598a6605c11f"
        },
        {
          "name": "Start or Get Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "    pm.collectionVariables.set('conversation_id', json.data.id);",
                  "    console.log('✅ conversation_id saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{finance_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participant_id\": \"{{participant_id}}\"\n}"
            },
            "description": "Mulai conversation baru atau ambil yang sudah ada.\n\nJika sudah ada conversation antara kedua user, akan dikembalikan conversation yang ada.\n\nRole yang diizinkan: **UMKM, Admin, CS, Finance**.\n\n**Auth:** Bearer Token"
          },
          "response": [
            {
              "name": "201 - Conversation Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"conversation ready\",\n  \"data\": {\n    \"id\": \"c4d5e6f7-a8b9-0123-c456-789012defabc\",\n    \"initiator_id\": \"b2c3d4e5-f6a7-8901-bcde-f12345678901\",\n    \"participant_id\": \"f6a7b8c9-d0e1-2345-fa67-890bcdef1234\",\n    \"last_message_at\": \"2026-03-02T09:00:00Z\",\n    \"created_at\": \"2026-03-01T14:00:00Z\",\n    \"updated_at\": \"2026-03-02T09:00:00Z\",\n    \"user_name\": \"Toko Umrah Jaya\",\n    \"user_role\": \"umkm\",\n    \"last_message\": \"Mohon proses pencairan dana penjualan\",\n    \"last_message_time\": \"2026-03-02T09:00:00Z\",\n    \"unread_count\": 0\n  },\n  \"errors\": null,\n  \"meta\": null\n}"
            },

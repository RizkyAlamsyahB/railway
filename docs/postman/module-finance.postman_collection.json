              "body": "{\n  \"success\": true,\n  \"message\": \"conversation ready\",\n  \"data\": {\n    \"id\": \"d5e6f7a8-b9c0-1234-d567-890123efabcd\",\n    \"initiator_id\": \"d4e5f6a7-b8c9-0123-def4-567890abcdef\",\n    \"participant_id\": \"f6a7b8c9-d0e1-2345-fa67-890bcdef1234\",\n    \"last_message_at\": \"2026-03-02T09:00:00Z\",\n    \"created_at\": \"2026-03-01T14:00:00Z\",\n    \"updated_at\": \"2026-03-02T09:00:00Z\",\n    \"user_name\": \"Admin Dev\",\n    \"user_role\": \"admin\",\n    \"last_message\": \"Tolong cek refund order #12345\",\n    \"last_message_time\": \"2026-03-02T09:00:00Z\",\n    \"unread_count\": 2\n  },\n  \"errors\": null,\n  \"meta\": null\n}"
            },

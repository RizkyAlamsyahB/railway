      "item": [
        {
          "id": "0316f6a7-dc31-4cd6-858d-c450e3752d97",
          "name": "Login Finance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('finance_token', json.data.token);",
                  "    console.log('✅ finance_token saved');",
                  "} else {",
                  "    console.log('❌ Login failed, token not saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"finance@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Login sebagai finance untuk mendapatkan JWT token.\n\nToken disimpan otomatis ke variable `finance_token`."
          },
          "response": []
        }
      ]
    },

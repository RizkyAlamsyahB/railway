APP_NAME=haji-umroh-store-be
APP_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=myapp://
TRAEFIK_API_DOMAIN=api.example.com
TRAEFIK_POSTGRES_DOMAIN=postgres.example.com

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=haji_umroh_store
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY_HOURS=24
JWT_ISSUER=haji-umroh-store-be

# Admin seed (used by `make seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=System Administrator
ADMIN_PHONE=0811111

# Object Storage
STORAGE_PROVIDER=s3
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_BUCKET=kemenhaj
STORAGE_S3_ACCESS_KEY=xxx
STORAGE_S3_SECRET_KEY=xxx
STORAGE_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_BASE_URL=https://kemenhaj.s3.ap-southeast-1.amazonaws.com
STORAGE_UPLOAD_MAX_SIZE_MB=10

# SMTP Email (Gmail: use App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Haji Umroh Store

# Xendit Payment Platform
XENDIT_API_SECRET_KEY=xnd_development_xxxxxxxx
XENDIT_API_PUBLIC_KEY=xnd_public_development_xxxxxxxx
XENDIT_BASE_URL=https://api.xendit.co
